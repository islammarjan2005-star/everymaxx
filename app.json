{
  "expo": {
    "name": "EveryMaxx",
    "slug": "everymaxx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.everymaxx.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D0F"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.everymaxx.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "backgroundColor": "#0D0D0F",
      "name": "EveryMaxx",
      "shortName": "EveryMaxx",
      "description": "Science-driven self-improvement app - Level up your life",
      "themeColor": "#6C5CE7"
    },
    "experiments": {
      "baseUrl": "./"
    },
    "plugins": [],
    "extra": {
      "eas": {
        "projectId": "everymaxx"
      }
    }
  }
}
